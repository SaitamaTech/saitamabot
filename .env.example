# Runtime
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=0
DATABASE_URL=postgresql://saitama:saitama@localhost:5432/saitama_bot
PGSSL=false

# Required for secure auth/session features. Generate with:
# openssl rand -hex 32
JWT_SECRET=replace_with_a_random_64_character_hex_secret
SESSION_ENCRYPTION_KEY=replace_with_a_random_64_character_hex_secret
SESSION_DIR=./data/sessions

# Owner identity (owner-only dashboard); use a verified email address.
OWNER_EMAIL=owner@example.com
OWNER_NUMBER=2348012345678
OWNER_NAME=Saitama Tech

# Bot configuration
BOT_NAME=SAITAMA BOT
BOT_PREFIX=.
WHATSAPP_CHANNEL_URL=

# Optional providers. Commands clearly report if a provider is not configured.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
TMDB_API_KEY=
WEATHER_API_KEY=

# Optional future integrations
SUPABASE_URL=
# Public Supabase anon/publishable key; no service-role key is used.
SUPABASE_ANON_KEY=
SHORTENER_API_URL=https://cleanuri.com/api/v1/shorten
COMPILER_API_URL=
COMPILER_API_KEY=
SCREENSHOT_API_URL=
SCREENSHOT_API_KEY=
TTS_API_URL=
TTS_API_KEY=
GFX_API_URL=
GFX_API_KEY=
